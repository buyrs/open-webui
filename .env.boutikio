# Boutikio Open WebUI Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Required Secrets
# =============================================================================

# Open WebUI session encryption key (generate a random string)
WEBUI_SECRET_KEY=your-secret-key-here

# OAuth client secret from Boutikio OAuth provider
BOUTIKIO_OAUTH_SECRET=your-oauth-client-secret-here

# Alibaba Cloud DashScope API key for Qwen3.5-Plus
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# =============================================================================
# OAuth Configuration (JSON)
# =============================================================================

# OAuth providers configuration as JSON string
# This is injected into OAUTH_PROVIDERS environment variable
OAUTH_PROVIDERS_JSON={"boutikio":{"client_id":"open-webui","client_secret":"${BOUTIKIO_OAUTH_SECRET}","server_url":"https://app.boutikio.com","scope":"openid profile email partner","redirect_uri":"https://chat.boutikio.com/oauth/callback","provider_name":"Boutikio","icon_url":"/static/boutikio-logo.svg"}}

# =============================================================================
# Frontend URLs (Vite build-time variables)
# =============================================================================

# Boutikio backend base URL (OAuth, OpenClaw API, embedded pages)
# Change for staging: https://staging.boutikio.com
VITE_BOUTIKIO_BASE_URL=https://app.boutikio.com

# Open WebUI public URL (canonical URLs, SEO, hreflang)
# Change for staging: https://chat-staging.boutikio.com
VITE_WEBUI_PUBLIC_URL=https://chat.boutikio.com
