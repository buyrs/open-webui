# Boutikio Open WebUI Environment Configuration

# =============================================================================
# Required Secrets
# =============================================================================

# Open WebUI session encryption key
WEBUI_SECRET_KEY=6c65a1534873408f356313dcb3aa82f3a3bd8954b44af2261dc73e98a9331a10

# Alibaba Cloud DashScope API key for Qwen3.5-Plus
DASHSCOPE_API_KEY=sk-sp-476c0953592e44cebc1a1e6625d67d79

# =============================================================================
# Database (MariaDB on Plesk host)
# =============================================================================
# Use host.docker.internal because "localhost" inside Docker means the container, not the host
DATABASE_URL=mysql+pymysql://chat:YOUR_DB_PASSWORD_HERE@host.docker.internal:3306/chat

# =============================================================================
# OAuth Configuration (OIDC provider)
# =============================================================================

OAUTH_CLIENT_ID=8fd877ab-ca67-4c00-8d27-44047ba75198
OAUTH_CLIENT_SECRET=kaS7WmFO3IEorewICGVRvB5KHsP64wQuS7iPgNVw
OAUTH_PROVIDER_NAME=Boutikio
OAUTH_SCOPES=openid profile email partner
OPENID_REDIRECT_URI=https://chat.boutikio.com/oauth/callback

# Individual OAuth endpoints (used when no discovery URL is available)
OAUTH_AUTHORIZE_URL=https://web.boutikio.com/oauth/authorize
OAUTH_TOKEN_URL=https://web.boutikio.com/oauth/token
OAUTH_USERINFO_URL=https://web.boutikio.com/oauth/userinfo

# If your Boutikio server exposes a discovery endpoint, use this instead
# of the three individual URLs above and remove them:
# OPENID_PROVIDER_URL=https://web.boutikio.com/.well-known/openid-configuration

# =============================================================================
# Branding & Auth Behavior
# =============================================================================

# Name shown in the UI
WEBUI_NAME=Boutikio

# Hide the email/password login form — force OAuth only
ENABLE_LOGIN_FORM=false

# Allow new users to be created via OAuth
ENABLE_OAUTH_SIGNUP=true

# Merge OAuth accounts by email (if a user already exists with same email)
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true

# Enable OAuth token exchange for tool servers (forwards partner OAuth tokens to OpenClaw)
ENABLE_OAUTH_TOKEN_EXCHANGE=true

# =============================================================================
# Frontend URLs (Vite build-time variables)
# =============================================================================

# Boutikio backend base URL
VITE_BOUTIKIO_BASE_URL=https://web.boutikio.com

# Open WebUI public URL
VITE_WEBUI_PUBLIC_URL=https://chat.boutikio.com
